    {
      "name": "2. Tenant - Gestión Comercial & Sucursales",
      "item": [
        {
          "name": "Empresa & Configuración",
          "item": [
            {
              "name": "Obtener Perfil y Configuración Consolidada de Empresa",
              "request": {
                "method": "GET",
                "header": [
                  {"key": "X-Tenant-ID", "value": "{{tenant_id}}", "type": "text"}
                ],
                "url": {
                  "raw": "{{base_url}}/api/v1/tenant/company",
                  "host": ["{{base_url}}"],
                  "path": ["api", "v1", "tenant", "company"]
                },
                "description": "Retorna la vista consolidada de la empresa: datos comerciales, configuración fiscal completa (con webhook_url, credenciales SOL) y estado/metadatos del certificado digital instalado (o null si aún no se ha subido)."
              },
              "response": []
            },
            {
              "name": "Actualizar Empresa y Configuración Fiscal (PATCH Unificado)",
              "request": {
                "method": "PATCH",
                "header": [
                  {"key": "Content-Type", "value": "application/json"},
                  {"key": "X-Tenant-ID", "value": "{{tenant_id}}", "type": "text"}
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"razonSocial\": \"EMPRESA DE PRUEBA SUNAT S.A.\",\n  \"direccionFiscal\": \"AV. GARCILASO DE LA VEGA 1456, LIMA\",\n  \"logo\": \"https://mi-cdn.com/logos/empresa.png\",\n  \"entorno\": \"BETA\",\n  \"incluidoTributo\": true,\n  \"modoEmision\": \"PROPIO\",\n  \"idPse\": null,\n  \"webhookUrl\": \"https://mi-sistema.com/api/v1/sunat/webhook\",\n  \"envioAsincrono\": true,\n  \"userSol\": \"MODDATOS\",\n  \"passSol\": \"moddatos\",\n  \"sunatClientId\": \"\",\n  \"sunatClientSecret\": \"\",\n  \"numeroCuentaDetraccion\": \"00-000-000000\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/api/v1/tenant/company",
                  "host": ["{{base_url}}"],
                  "path": ["api", "v1", "tenant", "company"]
                },
                "description": "Endpoint unificado PATCH para actualizar parcialmente tanto los datos de la empresa (razón social, dirección, logo, entorno, incluido_tributo) como su configuración fiscal (webhookUrl, envío asíncrono, modo de emisión, credenciales SOL, etc.). Devuelve la entidad consolidada con su configuración y metadatos del certificado."
              },
              "response": []
            },
            {
              "name": "Subir Certificado Digital (.pfx, .p12, .pem)",
              "request": {
                "method": "POST",
                "header": [
                  {"key": "X-Tenant-ID", "value": "{{tenant_id}}", "type": "text"}
                ],
                "body": {
                  "mode": "formdata",
                  "formdata": [
                    {
                      "key": "file",
                      "type": "file",
                      "src": []
                    },
                    {
                      "key": "password",
                      "value": "12345678",
                      "description": "Opcional para .pem sin cifrar (el sistema autogenera y gestiona internamente la clave de cifrado). Obligatorio para .pfx, .p12 o PEM con clave privada cifrada.",
                      "type": "text"
                    }
                  ]
                },
                "url": {
                  "raw": "{{base_url}}/api/v1/tenant/company/certificate",
                  "host": ["{{base_url}}"],
                  "path": ["api", "v1", "tenant", "company", "certificate"]
                },
                "description": "Sube y valida un certificado digital (.pfx, .p12 o .pem). Si se sube un .pem sin contraseña (o vacía), el backend genera internamente una clave de protección segura y empaqueta el almacén PKCS12 (.pfx) para la firma UBL de SUNAT de forma 100% transparente. Por seguridad (OWASP), las contraseñas internas y las rutas físicas en disco nunca se exponen al cliente."
              },
              "response": []
            }
          ]
        },
