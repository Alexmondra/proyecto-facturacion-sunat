# ===================================================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO (SaaS Facturación SUNAT)
# ===================================================================
# Copia este archivo como .env para desarrollo local:
#   cp .env.example .env

# Puerto de la aplicación (por defecto 8080)
SERVER_PORT=8080

# Perfil activo: 'dev' (desarrollo local) o 'prod' (producción)
SPRING_PROFILES_ACTIVE=dev

# -------------------------------------------------------------------
# Base de Datos PostgreSQL
# -------------------------------------------------------------------
# En 'dev': si no defines estas variables, tomará postgresql://localhost:5432/facturacion_sunat (postgres/admin)
# En 'prod': estas variables son obligatorias.
DB_URL=jdbc:postgresql://localhost:5432/facturacion_sunat
DB_USER=postgres
DB_PASSWORD=admin
