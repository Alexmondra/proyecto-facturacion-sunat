# =============================================================================
# CONFIGURACIÓN LOCAL Y SECRETOS (.env)
# Copia este archivo como .env en la raíz del proyecto para trabajar en local
# =============================================================================

# Base de Datos Local (opcional, tiene valores por defecto en application-dev.properties)
# DB_URL=jdbc:postgresql://localhost:5432/facturacion_sunat
# DB_USER=postgres
# DB_PASSWORD=admin

# Servicio Central de Identidad (DNI y RUC)
IDENTIDAD_DNI_URL=https://api-central.tuservicio.com/api/v1/dni
IDENTIDAD_RUC_URL=https://api-central.tuservicio.com/api/v1/ruc
IDENTIDAD_API_KEY=tu_token_secreto_aqui
IDENTIDAD_TIMEOUT_MS=3000
